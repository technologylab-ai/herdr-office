{
  "name": "herdr-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,office 'tsx server/index.ts' 'vite --host 127.0.0.1'",
    "demo": "npm run build && tsx server/demo-index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --serve",
    "test": "tsx --test server/*.test.ts src/world/*.test.ts",
    "test:browser": "playwright test",
    "models": "node scripts/generate-models.mjs"
  },
  "dependencies": {
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "description": "A local 3D office for live Herdr workspaces, agents and terminals.",
  "engines": {
    "node": ">=22.12.0"
  }
}
